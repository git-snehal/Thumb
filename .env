# Copy this file to .env and fill it in:   cp .env.example .env && nano .env
# Docker reads it automatically (docker-compose.yml). On a plain server the systemd service reads it too.
# Keep it private: it holds your bot token. (chmod 600 .env)

# --- required -----------------------------------------------------------------------------
# From @BotFather: /mybots -> your bot -> API Token
BOT_TOKEN=8652183679:AAFjViJO4KURTp510kDIVohAUS3Ro5IR3wk

# --- optional: who may use the bot --------------------------------------------------------
# Comma-separated Telegram user IDs. Empty = anyone can use it. (Find your ID with @userinfobot.)
ALLOWED_USER_IDS=
# These users are always allowed and never rate-limited.
ADMIN_IDS=8943414553
# Render actions per person per minute (a normal render = 1, HD file = 2, Preview all = 3). 0 = unlimited.
RATE_LIMIT_PER_MIN=

# --- optional: look and feel --------------------------------------------------------------
BRAND_NAME=
BRAND_POSITION=tr          # corner for the brand text: tl, tr, bl, br
LOGO_POSITION=tl
FANCY_TEXT=true
SPECIAL_DEFAULTS=true      # built-in OD3N watermark / credit in the Special Design
SPECIAL_WATERMARK_OPACITY=0.11
SPECIAL_BOXES_OPACITY=1.0

# --- optional: HD artwork from TMDB (free key: themoviedb.org -> Settings -> API) ----------
TMDB_API_KEY=336d5b53c37d440b1a62b44e762cc16c

# --- optional: server tuning --------------------------------------------------------------
# Banners rendered at the same time. Each needs roughly 300-500 MB of RAM: use 1 on a 1 GB server, 2 on 2-4 GB.
RENDER_CONCURRENCY=3
# AI background removal for uploaded characters. Needs about 1 GB extra RAM while it runs. false = off.
AUTO_CUTOUT=true
CACHE_TTL=3600
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR

# Where saved data lives. Docker sets this for you (/app/data/bot.db); leave empty for ./data/bot.db otherwise.
DB_PATH=
