# From @BotFather: /mybots -> your bot -> API Token
BOT_TOKEN=

# --- optional: who may use the bot --------------------------------------------------------
ALLOWED_USER_IDS=
# These users are always allowed and never rate-limited.
ADMIN_IDS=
# Render actions per person per minute (a normal render = 1, HD file = 2, Preview all = 3). 0 = unlimited.
RATE_LIMIT_PER_MIN=20

# --- optional: look and feel --------------------------------------------------------------
BRAND_NAME=
BRAND_POSITION=tr          # corner for the brand text: tl, tr, bl, br
LOGO_POSITION=tl
FANCY_TEXT=true
SPECIAL_DEFAULTS=true      
SPECIAL_WATERMARK_OPACITY=0.11
SPECIAL_BOXES_OPACITY=1.0

# (free key: themoviedb.org -> Settings -> API)
TMDB_API_KEY=

# (free personal key: fanart.tv -> sign up -> profile -> API key)
FANART_API_KEY=
EXTRA_ART_SOURCES=true     # Jikan + Kitsu posters in "Next image" (no key needed)
UPSCALE_SMALL_ART=true     # cleaner enlargement of small covers
TITLE_LOGOS=true           # real title logos on Posters 9 and 10 when one exists

WATERMARK_TEXT=            # faint diagonal text, e.g. @MyAnimeHub
WATERMARK_KEY=             # secret phrase for an invisible mark: python -m bot.watermark verify <image> <key>

RENDER_CONCURRENCY=2
# AI background removal for uploaded characters. false = off.
AUTO_CUTOUT=true
CACHE_TTL=3600
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR

# Where saved data lives. Docker sets this for you (/app/data/bot.db); leave empty for ./data/bot.db otherwise.
DB_PATH=
